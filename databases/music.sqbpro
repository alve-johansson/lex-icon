<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="music.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="873"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title=".Browsables" custom_title="0" dock_id="1" table="0,10:Browsables"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE specific_student (
    student_id INTEGER PRIMARY KEY,
    name TEXT
);

CREATE TABLE specific_instrument (
    instrument_id INTEGER PRIMARY KEY,
    name TEXT
);

CREATE TABLE specific_teacher (
    teacher_id INTEGER PRIMARY KEY,
    name TEXT
);

CREATE TABLE specific_lesson (
    lesson_id INTEGER PRIMARY KEY,
    date INTEGER,        -- YYYYMMDD
    time INTEGER,        -- HHMM
    room INTEGER,
    teacher_id INTEGER,
    instrument_id INTEGER, 
    FOREIGN KEY (teacher_id) REFERENCES specific_teacher(teacher_id),
    FOREIGN KEY (instrument_id) REFERENCES specific_instrument(instrument_id)
);


CREATE TABLE specific_student_lessons (
    student_id INTEGER,
    lesson_id INTEGER,
    PRIMARY KEY (student_id, lesson_id),
    FOREIGN KEY (student_id) REFERENCES specific_student(student_id),
    FOREIGN KEY (lesson_id) REFERENCES specific_lesson(lesson_id)
);

CREATE TABLE specific_teachers_instruments (
    teacher_id INTEGER,
    instrument_id INTEGER,
    PRIMARY KEY (teacher_id, instrument_id), 
    FOREIGN KEY (teacher_id) REFERENCES specific_teacher(teacher_id),
    FOREIGN KEY (instrument_id) REFERENCES specific_instrument(instrument_id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
